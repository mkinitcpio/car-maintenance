{
  "name": "car-maintenance",
  "version": "4.4.0",
  "description": "App for log your car parts maintenance such as engine, oil and any what you want! Manage cost, date and mileage.",
  "homepage": "https://github.com/mkinitcpio/car-maintenance",
  "author": {
    "name": "Aliaksandr Kazhamiaka",
    "email": "aliaksandr.kazhamiaka@gmail.com"
  },
  "keywords": [
    "angular",
    "angular 17",
    "electron",
    "nodejs",
    "typescript",
    "spectron",
    "eslint",
    "sass",
    "windows",
    "mac",
    "linux"
  ],
  "main": "main.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "icons:sprites": "node scripts/build-icon-sprites.js",
    "ng": "ng",
    "start": "npm-run-all -p electron:serve ng:serve",
    "build": "npm run icons:sprites && npm run electron:serve-tsc && ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "ng:serve": "npm run icons:sprites && ng serve -c web -o",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && npx electron . --serve",
    "electron:local": "npm run build:prod && npx electron .",
    "electron:build-linux": "npm run build:prod && electron-builder --linux",
    "electron:build-mac": "npm run build:prod && electron-builder --mac",
    "electron:build-windows": "npm run build:prod && electron-builder --windows",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "npm run build:prod && cross-env TS_NODE_PROJECT='e2e/tsconfig.e2e.json' mocha --timeout 300000 --require ts-node/register e2e/**/*.e2e.ts",
    "lint": "ng lint",
    "storybook": "npm run icons:sprites && ng run angular-electron:storybook",
    "build-storybook": "ng run angular-electron:build-storybook"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "22.2.5",
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/language-server": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@electron/remote": "2.1.4",
    "@ngrx/effects": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "app-builder": "7.0.4",
    "app-builder-bin": "4.2.0",
    "electron-store": "8.1.0",
    "material-icons": "1.10.6",
    "rxjs": "7.8.1",
    "save": "2.9.0",
    "tslib": "2.6.2",
    "uuid": "8.3.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "22.0.1",
    "@angular-eslint/builder": "18.2.0",
    "@angular-eslint/eslint-plugin": "18.2.0",
    "@angular-eslint/eslint-plugin-template": "18.2.0",
    "@angular-eslint/schematics": "18.2.0",
    "@angular-eslint/template-parser": "18.2.0",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "@playwright/test": "1.40.1",
    "@storybook/angular": "10.6.2",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "8.0.0",
    "@typescript-eslint/parser": "8.0.0",
    "conventional-changelog-cli": "3.0.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.1",
    "electron-debug": "4.0.0",
    "electron-reloader": "1.2.3",
    "eslint": "9.8.0",
    "jsdom": "30.1.3",
    "node-polyfill-webpack-plugin": "2.0.1",
    "npm-run-all": "4.1.5",
    "patch-package": "8.0.1",
    "playwright": "1.40.1",
    "storybook": "10.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "wait-on": "7.2.0",
    "webdriver-manager": "12.1.9",
    "webpack": "5.112.2"
  }
}
